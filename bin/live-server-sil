#!/bin/bash
# live-server-sil [port]
# Start live-server in the background and print a single clickable link.
# Serves the current directory.
#
# The link is the Windows LAN address, not the WSL one, so it also works from a
# phone on the same network. WSL2 is a NAT'd VM, so that needs a Windows-side
# port forward and firewall rule; wsl-port-open adds them, which costs one UAC
# prompt the first time a given port is used. Set LIVE_SERVER_NO_LAN=1 to skip
# all of that and print the WSL-only address instead.

IF=eth0

PORT="${1:-8213}"

case "$PORT" in
    ''|*[!0-9]*)
        echo "error: port must be a number" >&2
        exit 1
        ;;
esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo "error: port must be between 1 and 65535" >&2
    exit 1
fi

IP=$(ip -4 -o addr show dev "$IF" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
if [ -z "$IP" ]; then
    echo "error: no IPv4 address on interface '$IF'" >&2
    exit 1
fi

# Serialize port selection so concurrent invocations cannot both choose the
# same port before either live-server has started listening.
exec 9>"/tmp/live-server-sil-${UID}.lock"
flock 9

port_is_open() {
    ss -H -ltn "sport = :$1" 2>/dev/null | grep -q .
}

while port_is_open "$PORT"; do
    PORT=$((PORT + 1))
    if [ "$PORT" -gt 65535 ]; then
        echo "error: no available port found" >&2
        exit 1
    fi
done

URL="http://${IP}:${PORT}/"

# Prefer the Windows LAN address so the printed link also works from a phone.
# Registering the forward can fail (UAC declined, Windows unreachable); that is
# not worth failing a server over, so keep the WSL URL when it does.
lan_url() {
    [ -n "$LIVE_SERVER_NO_LAN" ] && return 1
    # stdout is captured by the caller, so its progress lines must go to stderr
    wsl-port-open -q "$PORT" >&2 || return 1
    local win_ip
    win_ip=$(wsl-win-ip 2>/dev/null) || return 1
    [ -z "$win_ip" ] && return 1
    printf 'http://%s:%s/\n' "$win_ip" "$PORT"
}

# run detached; discard live-server's own output
nohup npx live-server --quiet --no-browser --host="$IP" --port="$PORT" 9>&- >/dev/null 2>&1 &
server_pid=$!

# Keep the selection lock until this port is actually listening. This closes
# the check/start race between two simultaneous live-server-sil processes.
listening=0
for ((attempt = 0; attempt < 200; attempt++)); do
    if port_is_open "$PORT"; then
        listening=1
        break
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
        wait "$server_pid" 2>/dev/null
        echo "error: live-server failed to start on port $PORT" >&2
        exit 1
    fi
    sleep 0.05
done

if [ "$listening" -ne 1 ]; then
    kill "$server_pid" 2>/dev/null
    echo "error: timed out starting live-server on port $PORT" >&2
    exit 1
fi

disown

# Only now is the port really listening, which is when the forward is worth
# registering.
lan=$(lan_url) && URL="$lan"

# one line, URL rendered as a clickable hyperlink (OSC 8)
printf 'start at \033]8;;%s\033\\%s\033]8;;\033\\\n' "$URL" "$URL"
